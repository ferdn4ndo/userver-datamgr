# Superuser created on first init (empty data volume). When using uServer orchestration, set this to the same value as USERVER_DB_USER in the stack .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# PG 18+ image default is /var/lib/postgresql/18/docker; compose mounts dbdata at /var/lib/postgresql.
# Set PGDATA only if you need a non-default path (e.g. legacy layout).
#PGDATA=/var/lib/postgresql/18/docker

# TLS is enabled on the server.
# Local/dev: ./postgres/generate-ssl.sh → postgres/ssl/{server.crt,server.key} (ssl-local mount).
# Production (userver stack): userver-web acme-companion writes certs under ../userver-web/certs; compose sets
# POSTGRES_SSL_CERT_BASENAME and USERVER_WEB_CERTS_DIR in userver-datamgr/.env (see deploy_userver_datamgr.sh).
# HTTP-01 for the DB hostname uses service userver-postgres-acme + postgres/certs-helper.env (VIRTUAL_HOST / LETSENCRYPT_*).
# External clients: sslmode=require (or verify-full with the public CA).
